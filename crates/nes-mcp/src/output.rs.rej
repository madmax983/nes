--- /dev/null
+++ /dev/null
@@ -422,11 +422,11 @@
         assert_eq!(meta.frame_seq, 10);
         assert_eq!(meta.audio_seq, 5);

-        let chunk = frame_chunk(meta.frame_seq).unwrap();
+        let chunk = frame_chunk(meta.frame_seq).expect("failed");
         assert_eq!(chunk.seq, 10);
         assert_eq!(chunk.rgba.len(), 256 * 240 * 4);

-        let chunk = audio_chunk(meta.audio_seq).unwrap();
+        let chunk = audio_chunk(meta.audio_seq).expect("failed");
         assert_eq!(chunk.seq, 5);
